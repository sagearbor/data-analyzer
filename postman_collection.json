      "key": "BASE_URL",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "API_KEY",
      "value": "your-api-key-here",
      "type": "string"
    },
    {
      "key": "ADMIN_PASSWORD",
      "value": "your-admin-password-here",
      "type": "string"
    },
    {
      "key": "PROGRAM_ID",
      "value": "",
