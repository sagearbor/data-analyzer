# -----------------------------------------------------------------
# Environment Variables for Data Analyzer
# -----------------------------------------------------------------
#
# INSTRUCTIONS:
# 1. Copy this file to a new file named '.env' in the root directory
# 2. The .env file is listed in .gitignore and will NOT be committed
# 3. Fill in the values for your specific deployment
#
# -----------------------------------------------------------------

# -- Environment Banner Configuration --
# Controls the environment warning banner displayed in the web UI
# Options: dev, staging, prod
#   - dev: Red banner "DEV - do NOT use real data or files with PHI."
#   - staging: Yellow banner "STAGING - do NOT use real data or files with PHI."
#   - prod: No banner (production - banner hidden)
#   - (not set): Red banner with "DEV" (fail-safe default)
APP_ENV=dev

# -- Azure OpenAI Configuration (Optional) --
# Required only if using AI-powered dictionary parsing features
# Leave commented if not using LLM features
# AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-api-key-here
# AZURE_OPENAI_DEPLOYMENT=gpt-5-nano

# -- Data Analyzer REST API Configuration --
# web_app.py's DataQualityAnalyzer POSTs uploaded datasets to api_server.py's
# POST /api/v1/analyze endpoint instead of running the analysis engine
# in-process (see web_app.py's DataQualityAnalyzer docstring).
#
# Base URL of the data-analyzer REST API (api_server.py). Defaults to
# http://localhost:8000 for local dev, matching api_server.py's own
# API_PORT default. For a real deployment, contact IT/DevOps for the correct
# internal service URL - do not hardcode a real hostname here.
DATA_ANALYZER_API_URL=http://localhost:8000
# Shared secret sent as the X-API-Key header on every request to the API.
# Must match the API app's own DATA_ANALYZER_API_KEY (set this env var on
# both the UI and the API for local dev/testing).
DATA_ANALYZER_API_KEY=your-api-key-here
