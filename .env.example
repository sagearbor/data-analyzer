# -----------------------------------------------------------------
# Environment Variables for Data Analyzer
# -----------------------------------------------------------------
#
# INSTRUCTIONS:
# 1. Copy this file to a new file named '.env' in the root directory
# 2. The .env file is listed in .gitignore and will NOT be committed
# 3. Fill in the values for your specific deployment
#
# -----------------------------------------------------------------

# -- Environment Banner Configuration --
# Controls the environment warning banner displayed in the web UI
# Options: dev, staging, prod
#   - dev: Red banner "DEV - do NOT use real data or files with PHI."
#   - staging: Yellow banner "STAGING - do NOT use real data or files with PHI."
#   - prod: No banner (production - banner hidden)
#   - (not set): Red banner with "DEV" (fail-safe default)
APP_ENV=dev

# -- Azure OpenAI Configuration (Optional) --
# Required only if using AI-powered dictionary parsing features
# Leave commented if not using LLM features
# Auth is KEYLESS via src/dcri_llm.py: locally `az login` (AzureCliCredential),
# on ACA the user-assigned managed identity (AZURE_CLIENT_ID). No API key.
# AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-5-nano
# SOLUTION_NAME=data-analyzer-api        # telemetry tag (data-analyzer-ui for the UI)
# LLM_AUTH=identity

# -- Data Analyzer REST API Configuration --
# web_app.py's DataQualityAnalyzer POSTs uploaded datasets to api_server.py's
# POST /api/v1/analyze endpoint instead of running the analysis engine
# in-process (see web_app.py's DataQualityAnalyzer docstring).
#
# Base URL of the data-analyzer REST API (api_server.py). Defaults to
# http://localhost:8000 for local dev, matching api_server.py's own
# API_PORT default. For a real deployment, contact IT/DevOps for the correct
# internal service URL - do not hardcode a real hostname here.
DATA_ANALYZER_API_URL=http://localhost:8000
# Shared secret sent as the X-API-Key header on every request to the API.
# Must match the API app's own DATA_ANALYZER_API_KEY (set this env var on
# both the UI and the API for local dev/testing).
DATA_ANALYZER_API_KEY=your-api-key-here

# -- Azure OpenAI Deployment Choices (Optional) --
# Comma-separated list of deployment names offered in the "LLM model" dropdown
# in the Dictionary panel. The first entry is the default selection. This is also
# the server-side ALLOW-LIST: a model not listed here is refused where the call is
# made (error_class=deployment_not_allowed). List only models verified to answer.
# If unset, defaults to the single AZURE_OPENAI_DEPLOYMENT value above.
# Example: AZURE_OPENAI_DEPLOYMENTS=gpt-5-nano,gpt-5.4-mini,gpt-5.5
# AZURE_OPENAI_DEPLOYMENTS=gpt-5-nano


# -- Streamlit UI limits and hardening (all optional; safe defaults shown) --
# Max size of one uploaded file in MB (data and dictionary). Default 25: well
# under the API's 100 MB default and sized for a 1 GiB single replica.
# UI_MAX_UPLOAD_MB=25
# Dictionary PDFs above this many pages, or more than this many characters of
# text (any dictionary format sent to AI parsing), are refused with a message.
# UI_PDF_MAX_PAGES=200
# UI_DICT_MAX_CHARS=500000
# A PDF page whose content stream is larger than this many bytes is refused
# before any text is extracted from it.
# UI_PDF_MAX_PAGE_BYTES=5000000
# Parsed-dictionary cache: entries are private to one browser session and expire
# after this many hours (expired entries are pruned automatically).
# UI_CACHE_TTL_HOURS=12
# DICT_CACHE_DIR=/tmp/data_analyzer_ui_cache_v2
# Streamlit XSRF + CORS protection is ON by default. LOCAL USE ONLY: set to 1 to
# turn both off (ignored on Azure Container Apps and when APP_ENV is not
# dev/local/test).
# STREAMLIT_INSECURE_LOCAL_ONLY=0

# -- Limits added for release 1.0 (security review) --
# API upload and dataset limits (api_server.py / mcp_server.py). Defaults shown.
# DATA_ANALYZER_MAX_DICTIONARY_UPLOAD_BYTES=2097152
# DATA_ANALYZER_MAX_ROWS=1000000
# DATA_ANALYZER_MAX_COLUMNS=2000
# DATA_ANALYZER_MAX_EXCEL_UNCOMPRESSED_BYTES=52428800
# DATA_ANALYZER_MAX_EXCEL_SHEETS=50
# DATA_ANALYZER_MAX_EXCEL_ARCHIVE_MEMBERS=2000
# DATA_ANALYZER_MAX_ISSUES_RETURNED=1000
# Wrong-key throttle: failures allowed per client within the window.
# DATA_ANALYZER_AUTH_FAIL_LIMIT=10
# DATA_ANALYZER_AUTH_FAIL_WINDOW_SECONDS=300
# Client id for rate limiting and the wrong-key throttle. Default 0 = the TCP peer
# address. Behind a reverse proxy / ingress that APPENDS the caller's address to
# X-Forwarded-For, set N = number of trusted proxies (1 = the nearest one): the Nth
# entry counted from the RIGHT is used. Never set it when clients can reach the
# app directly (the header would be forgeable).
# DATA_ANALYZER_TRUSTED_PROXY_HOPS=0
# Admin password. No default: when unset, admin actions are refused.
# DATA_ANALYZER_ADMIN_PASSWORD=
#
# AI model call limits (src/llm_client.py). Defaults shown.
# LLM_RESPONSES_STORE=false        # false | true | omit (omit = leave the field out if a model rejects it)
# LLM_MAX_CHUNKS=20                # one chunk = one model call per dictionary
# LLM_MAX_INPUT_CHARS=500000
# LLM_ALLOW_INSECURE_ENDPOINT=0    # 1 = allow a non-https endpoint (local development only)
